# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Gemini API key (server-only, no NEXT_PUBLIC_ prefix). Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=[PLACEHOLDER — your Gemini API key]

# Optional. Defaults to gemini-3.6-flash if unset. See src/lib/gemini.ts —
# check Google AI Studio for the current recommended fast/cheap tier if this
# model is deprecated by the time you read this.
# GEMINI_MODEL=gemini-3.6-flash

# Supabase project. Find these in Supabase dashboard > Project Settings > API.
# Run supabase/schema.sql once in the SQL editor against a fresh project
# before using auth/history/team features.
NEXT_PUBLIC_SUPABASE_URL=[PLACEHOLDER — https://xxxx.supabase.co]
NEXT_PUBLIC_SUPABASE_ANON_KEY=[PLACEHOLDER — the anon/public key, safe for client-side use]

# Service role key — server-only, NEVER expose to the client. Used only for
# inviting teammates (auth.admin.inviteUserByEmail) and the Stripe webhook's
# account.tier update, both of which need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=[PLACEHOLDER — Project Settings > API > service_role key]

# Free-tier monthly check cap per account (shared across the team).
# FREE_TIER_MONTHLY_LIMIT=20

# Stripe (Phase 4 billing). Use test-mode keys (sk_test_.../whsec_...) until
# ready to go live. Webhook endpoint to register in the Stripe dashboard:
# https://<your-domain>/api/billing/webhook, listening for at least:
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted.
STRIPE_SECRET_KEY=[PLACEHOLDER — sk_test_...]
STRIPE_WEBHOOK_SECRET=[PLACEHOLDER — whsec_... from the webhook's settings page]
STRIPE_PRICE_ID=[PLACEHOLDER — price_... for the Pro monthly subscription]
